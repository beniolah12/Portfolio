      <span class="service-price">15 000 Ft / hó</span>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="munkak">
  <div class="section-label">// kiemelt projektek</div>
  <div class="projects-grid reveal">
    <div class="project-card wide">
      <div>
        <div class="proj-num">001 / kiemelt</div>
        <div class="proj-cat cat-web">weboldal</div>

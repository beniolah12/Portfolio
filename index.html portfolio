<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DevCraft — Weboldalak kis vállalkozásoknak</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --black: #080808;
    --white: #f2efe8;
    --lime: #c8ff00;
    --lime-dim: #a8d800;
    --grey: #1a1a1a;
    --grey2: #2a2a2a;
    --muted: #555;
    --muted2: #888;
    --font-display: 'Syne', sans-serif;
    --font-mono: 'DM Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: var(--font-display);
    overflow-x: hidden;
    cursor: none;
  }

  /* CURSOR */
  .cursor {
    width: 10px; height: 10px;
    background: var(--lime);
    border-radius: 50%;
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.15s ease, width 0.2s, height 0.2s;
    transform: translate(-50%, -50%);
  }
  .cursor.hovering {
    width: 40px; height: 40px;
    background: transparent;
    border: 1.5px solid var(--lime);
  }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.3;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.25rem 2.5rem;
    border-bottom: 1px solid #151515;
    background: rgba(8,8,8,0.92);
    backdrop-filter: blur(12px);
  }
  .nav-logo {
    font-size: 1rem; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--lime);
  }
  .nav-links {
    display: flex; gap: 2.5rem;
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--muted);
  }
  .nav-links a {
    color: var(--muted); text-decoration: none;
    transition: color 0.2s; letter-spacing: 0.05em;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-cta {
    font-family: var(--font-mono); font-size: 0.75rem;
    background: var(--lime); color: #000;
    padding: 0.5rem 1.25rem; border: none;
    cursor: none; font-weight: 500;
    letter-spacing: 0.05em; text-transform: uppercase;
    transition: background 0.2s, transform 0.2s;
  }
  .nav-cta:hover { background: #d4ff00; transform: translateY(-1px); }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 2.5rem 5rem;
    padding-top: 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(120px, 22vw, 280px);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px #1a1a1a;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.05em;
    opacity: 0.5;
  }

  .hero-eyebrow {
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--lime); letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 2rem;
    opacity: 0; animation: fadeUp 0.7s 0.2s ease forwards;
  }
  .hero-eyebrow::before {
    content: ''; width: 32px; height: 1px; background: var(--lime);
  }

  .hero-title {
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    margin-bottom: 2.5rem;
    opacity: 0; animation: fadeUp 0.7s 0.3s ease forwards;
  }
  .hero-title .line2 { color: var(--lime); display: block; }
  .hero-title .line3 { color: var(--muted); display: block; }

  .hero-bottom {
    display: flex; justify-content: space-between; align-items: flex-end;
    opacity: 0; animation: fadeUp 0.7s 0.5s ease forwards;
  }
  .hero-desc {
    font-family: var(--font-mono); font-size: 0.85rem;
    color: var(--muted2); max-width: 360px; line-height: 1.8;
  }
  .hero-actions { display: flex; gap: 1rem; align-items: center; }
  .btn-main {
    background: var(--lime); color: #000;
    padding: 1rem 2.25rem;
    font-family: var(--font-display); font-weight: 700;
    font-size: 0.9rem; border: none; cursor: none;
    letter-spacing: -0.01em;
    transition: all 0.2s; display: inline-block;
  }
  .btn-main:hover { background: #d4ff00; transform: translateY(-3px); }
  .btn-ghost {
    color: var(--muted2); font-family: var(--font-mono);
    font-size: 0.8rem; text-decoration: none;
    display: flex; align-items: center; gap: 0.5rem;
    transition: color 0.2s;
  }
  .btn-ghost:hover { color: var(--white); }

  /* MARQUEE */
  .marquee-wrap {
    border-top: 1px solid #151515;
    border-bottom: 1px solid #151515;
    overflow: hidden; padding: 0.9rem 0;
    background: var(--grey);
  }
  .marquee-track {
    display: flex; gap: 3rem;
    animation: marquee 20s linear infinite;
    white-space: nowrap;
  }
  .marquee-item {
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--muted); letter-spacing: 0.1em;
    text-transform: uppercase; flex-shrink: 0;
    display: flex; align-items: center; gap: 1.5rem;
  }
  .marquee-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--lime); }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* STATS */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid #151515;
  }
  .stat {
    padding: 2.5rem 2.5rem;
    border-right: 1px solid #151515;
    transition: background 0.3s;
  }
  .stat:last-child { border-right: none; }
  .stat:hover { background: #0d0d0d; }
  .stat-num {
    font-size: 2.5rem; font-weight: 800;
    letter-spacing: -0.04em; color: var(--white);
    display: flex; align-items: baseline; gap: 4px;
  }
  .stat-num sup { font-size: 1rem; color: var(--lime); }
  .stat-label {
    font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--muted); text-transform: uppercase;
    letter-spacing: 0.12em; margin-top: 0.4rem;
  }

  /* SECTION */
  section { padding: 5rem 2.5rem; }
  .section-label {
    font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--muted); text-transform: uppercase;
    letter-spacing: 0.15em; margin-bottom: 3rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: #1a1a1a;
  }

  /* SERVICES */
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: #151515;
  }
  .service-card {
    background: var(--black); padding: 2.5rem 2rem;
    transition: background 0.3s; position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 2px; background: var(--lime);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s ease;
  }
  .service-card:hover::before { transform: scaleX(1); }
  .service-card:hover { background: #0d0d0d; }
  .service-num {
    font-family: var(--font-mono); font-size: 0.65rem;
    color: #333; margin-bottom: 2rem; display: block;
  }
  .service-icon {
    font-size: 2rem; margin-bottom: 1.25rem; display: block;
  }
  .service-title {
    font-size: 1.2rem; font-weight: 700;
    letter-spacing: -0.02em; margin-bottom: 0.75rem;
  }
  .service-desc {
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--muted2); line-height: 1.7; margin-bottom: 1.5rem;
  }
  .service-price {
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--lime);
  }

  /* PROJECTS */
  .projects-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: #151515;
  }
  .project-card {
    background: var(--black); padding: 2.5rem;
    cursor: none; transition: background 0.25s;
    position: relative; overflow: hidden;
  }
  .project-card.wide { grid-column: span 2; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .project-card:hover { background: #0d0d0d; }
  .project-card:hover .proj-arrow { transform: translate(5px, -5px); color: var(--lime); }
  .proj-num {
    font-family: var(--font-mono); font-size: 0.65rem;
    color: #333; margin-bottom: 1.5rem;
  }
  .proj-cat {
    font-family: var(--font-mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  .cat-web { color: #4a9eff; }
  .cat-ai { color: var(--lime); }
  .cat-shop { color: #ff6b6b; }
  .proj-title {
    font-size: 1.6rem; font-weight: 700;
    letter-spacing: -0.03em; line-height: 1.1;
    margin-bottom: 1rem;
  }
  .project-card.wide .proj-title { font-size: 2.2rem; }
  .proj-desc {
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--muted2); line-height: 1.7; margin-bottom: 1.5rem;
  }
  .proj-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .proj-tag {
    font-family: var(--font-mono); font-size: 0.62rem;
    color: #444; border: 1px solid #222;
    padding: 0.3rem 0.65rem; letter-spacing: 0.04em;
  }
  .proj-arrow {
    position: absolute; top: 2.5rem; right: 2.5rem;
    font-size: 1.4rem; color: #2a2a2a;
    transition: transform 0.25s, color 0.25s;
  }
  .proj-visual {
    background: #0d0d0d; border: 1px solid #1a1a1a;
    border-radius: 4px; padding: 2rem;
    display: flex; align-items: center; justify-content: center;
    min-height: 220px;
  }
  .mock-window {
    width: 200px; background: #151515;
    border-radius: 6px; overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .mock-titlebar {
    background: #1a1a1a; padding: 8px 12px;
    display: flex; gap: 6px; align-items: center;
  }
  .mock-btn { width: 8px; height: 8px; border-radius: 50%; }
  .mock-body { padding: 12px; }
  .mock-row { height: 5px; background: #222; border-radius: 3px; margin-bottom: 7px; }
  .mock-row.lime { background: rgba(200,255,0,0.3); width: 55%; }
  .mock-row.short { width: 35%; }
  .mock-img { height: 70px; background: #1e1e1e; border-radius: 3px; margin-bottom: 7px; }

  /* PROCESS */
  .process-steps {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: #151515;
  }
  .process-step {
    background: var(--black); padding: 2.5rem 2rem;
    position: relative; transition: background 0.3s;
  }
  .process-step:hover { background: #0d0d0d; }
  .step-num {
    font-size: 4rem; font-weight: 800;
    color: #151515; letter-spacing: -0.05em;
    margin-bottom: 1rem; line-height: 1;
  }
  .step-title {
    font-size: 1rem; font-weight: 700;
    letter-spacing: -0.01em; margin-bottom: 0.75rem;
  }
  .step-desc {
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--muted); line-height: 1.7;
  }
  .step-time {
    font-family: var(--font-mono); font-size: 0.65rem;
    color: var(--lime); margin-top: 1rem; display: block;
  }

  /* TESTIMONIAL */
  .testimonial-section {
    background: var(--grey); border-top: 1px solid #151515;
    border-bottom: 1px solid #151515;
    padding: 4rem 2.5rem;
    display: flex; align-items: center; gap: 4rem;
  }
  .quote-mark {
    font-size: 8rem; font-weight: 800;
    color: var(--lime); line-height: 0.7;
    flex-shrink: 0; opacity: 0.3;
  }
  .testimonial-text {
    font-size: 1.5rem; font-weight: 600;
    letter-spacing: -0.02em; line-height: 1.4;
    max-width: 600px;
  }
  .testimonial-author {
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--muted); margin-top: 1.5rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .testimonial-author::before {
    content: ''; width: 24px; height: 1px; background: var(--muted);
  }

  /* CONTACT */
  .contact-section {
    padding: 6rem 2.5rem;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
    border-top: 1px solid #151515;
  }
  .contact-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800; letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .contact-title span { color: var(--lime); }
  .contact-sub {
    font-family: var(--font-mono); font-size: 0.8rem;
    color: var(--muted); margin-top: 1.5rem; line-height: 1.7;
  }
  .contact-links { display: flex; flex-direction: column; gap: 1.25rem; }
  .contact-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border: 1px solid #1a1a1a;
    text-decoration: none; color: var(--white);
    transition: all 0.25s; font-weight: 600;
    font-size: 1rem;
  }
  .contact-link:hover {
    border-color: var(--lime);
    background: rgba(200,255,0,0.05);
    transform: translateX(6px);
  }
  .contact-link-sub {
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--muted); font-weight: 400;
  }
  .contact-arrow { color: var(--lime); font-size: 1.2rem; }

  /* FOOTER */
  footer {
    padding: 1.5rem 2.5rem;
    border-top: 1px solid #0d0d0d;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: 0.68rem; color: #333;
  }
  .footer-status {
    display: flex; align-items: center; gap: 0.5rem;
  }
  .status-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--lime);
    animation: blink 2s ease infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .reveal {
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* MOBILE */
  @media (max-width: 768px) {
    nav { padding: 1rem 1.25rem; }
    .nav-links { display: none; }
    .hero { padding: 80px 1.25rem 3rem; }
    .hero-bg-text { font-size: 80px; }
    .hero-bottom { flex-direction: column; gap: 2rem; align-items: flex-start; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat { padding: 1.5rem; }
    .services-grid { grid-template-columns: 1fr; }
    .projects-grid { grid-template-columns: 1fr; }
    .project-card.wide { grid-column: span 1; display: block; }
    .proj-visual { display: none; }
    .process-steps { grid-template-columns: repeat(2, 1fr); }
    .testimonial-section { flex-direction: column; gap: 1rem; padding: 3rem 1.25rem; }
    .contact-section { grid-template-columns: 1fr; padding: 3rem 1.25rem; }
    section { padding: 3rem 1.25rem; }
  }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>

<nav>
  <div class="nav-logo">DevCraft™</div>
  <div class="nav-links">
    <a href="#munkak">munkák</a>
    <a href="#szolgaltatasok">szolgáltatások</a>
    <a href="#folyamat">folyamat</a>
    <a href="#kapcsolat">kapcsolat</a>
  </div>
  <button class="nav-cta" onclick="document.getElementById('kapcsolat').scrollIntoView({behavior:'smooth'})">Projektet indítok</button>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg-text">WEB</div>
  <div class="hero-eyebrow">elérhető projektekre · budapest, hu · 2025</div>
  <h1 class="hero-title">
    Weboldalak
    <span class="line2">amik dolgoznak</span>
    <span class="line3">helyetted.</span>
  </h1>
  <div class="hero-bottom">
    <p class="hero-desc">Gyors, modern weboldalakat készítek kis- és középvállalkozásoknak. Nem sablon — hanem valami ami tényleg eladja a vállalkozásodat.</p>
    <div class="hero-actions">
      <button class="btn-main" onclick="document.getElementById('kapcsolat').scrollIntoView({behavior:'smooth'})">Projektet indítok ↗</button>
      <a class="btn-ghost" href="#munkak">munkáim →</a>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <span class="marquee-item">Next.js <span class="marquee-dot"></span></span>
    <span class="marquee-item">React <span class="marquee-dot"></span></span>
    <span class="marquee-item">Tailwind CSS <span class="marquee-dot"></span></span>
    <span class="marquee-item">Supabase <span class="marquee-dot"></span></span>
    <span class="marquee-item">Vercel <span class="marquee-dot"></span></span>
    <span class="marquee-item">Stripe <span class="marquee-dot"></span></span>
    <span class="marquee-item">Claude API <span class="marquee-dot"></span></span>
    <span class="marquee-item">Figma <span class="marquee-dot"></span></span>
    <span class="marquee-item">Next.js <span class="marquee-dot"></span></span>
    <span class="marquee-item">React <span class="marquee-dot"></span></span>
    <span class="marquee-item">Tailwind CSS <span class="marquee-dot"></span></span>
    <span class="marquee-item">Supabase <span class="marquee-dot"></span></span>
    <span class="marquee-item">Vercel <span class="marquee-dot"></span></span>
    <span class="marquee-item">Stripe <span class="marquee-dot"></span></span>
    <span class="marquee-item">Claude API <span class="marquee-dot"></span></span>
    <span class="marquee-item">Figma <span class="marquee-dot"></span></span>
  </div>
</div>

<!-- STATS -->
<div class="stats reveal">
  <div class="stat">
    <div class="stat-num">14<sup>év</sup></div>
    <div class="stat-label">tapasztalt fejlesztő</div>

    <div class="stat-num">100<sup>%</sup></div>
    <div class="stat-label">egyedi design</div>
  </div>
  <div class="stat">
    <div class="stat-num">24<sup>/7</sup></div>
    <div class="stat-label">gyors kommunikáció</div>
  </div>
</div>

<!-- SERVICES -->
<section id="szolgaltatasok">
  <div class="section-label">// szolgáltatások</div>
  <div class="services-grid reveal">
    <div class="service-card">
      <span class="service-num">01 /</span>
      <span class="service-icon">⚡</span>
      <div class="service-title">Landing Page</div>
      <p class="service-desc">Egyoldalas, gyors, mobilra optimalizált oldal ami meggyőzi a látogatókat. SEO-barát, Google-ra optimalizált.</p>
      <span class="service-price">80 000 – 120 000 Ft</span>
    </div>
    <div class="service-card">
      <span class="service-num">02 /</span>
      <span class="service-icon">🌐</span>
